<style>
  .shoe-comp-body {
    margin: 0;
    padding: 40px 20px;
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Arial, sans-serif;
    background-color: rgba(245, 244, 246, 1);
    display: flex;
    justify-content: center;
    align-items: center;
    min-height: 100vh;
  }

  .shoe-comp-container {
    max-width: 1200px;
    width: 100%;
    padding: 50px;
    text-align: center;
  }

  .shoe-comp-heading {
    font-size: 48px;
    font-weight: 700;
    color: #2c2c2c;
    margin-bottom: 50px;
    line-height: 1.2;
  }

  .shoe-comp-highlight {
    color: #5cb85c;
  }

  .shoe-comp-wrapper {
    display: flex;
    justify-content: center;
    align-items: flex-start;
    margin-top: 40px;
  }

  .shoe-comp-section {
    flex: 1;
    max-width: 400px;
    display: flex;
    flex-direction: column;
  }

  .shoe-comp-header {
    margin-bottom: 30px;
    margin-top: 40px;
    width: 100%;
  }

  .shoe-comp-left .shoe-comp-header {
    text-align: right;
  }

  .shoe-comp-right .shoe-comp-header {
    text-align: left;
  }

  .shoe-comp-label {
    font-size: 18px;
    letter-spacing: 3px;
    margin-bottom: 10px;
    color: #5cb85c;
    font-weight: 400;
    text-transform: uppercase;
  }

  .shoe-comp-type {
    font-size: 36px;
    font-weight: 800;
    color: #2c2c2c;
    letter-spacing: 1px;
    line-height: 1.1;
    text-transform: uppercase;
  }

  .shoe-comp-features {
    text-align: left;
    width: 100%;
  }

  .shoe-comp-left .shoe-comp-features {
    margin-left: auto;
  }

  .shoe-comp-right .shoe-comp-features {
    margin-right: auto;
  }

  .shoe-comp-row {
    display: flex;
    align-items: center;
    margin-bottom: 10px;
    font-size: 17px;
    color: #333;
  }

  .shoe-comp-row:last-child {
    margin-bottom: 0;
  }

  .shoe-comp-left .shoe-comp-row {
    justify-content: flex-end;
  }

  .shoe-comp-right .shoe-comp-row {
    justify-content: flex-start;
  }

  .shoe-comp-text {
    white-space: nowrap;
  }

  .shoe-comp-arrow {
    color: #999;
    margin: 0 12px;
    font-size: 18px;
  }

  .shoe-comp-negative {
    color: #666;
  }

  .shoe-comp-positive {
    color: #2c2c2c;
    font-weight: 500;
  }

  .shoe-comp-image-container {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    flex: 0 0 auto;
    margin: 0 20px;
    padding-top: 15px;
  }

  .shoe-comp-image {
    max-width: 450px;
    width: 100%;
    height: auto;
  }
</style>

<div class="shoe-comp-body">
  <div class="shoe-comp-container">
    <h1 class="shoe-comp-heading">
      the difference is <span class="shoe-comp-highlight">night and day</span><br>
      with abstract chimp shoes
    </h1>

    <div class="shoe-comp-wrapper">
      <div class="shoe-comp-section shoe-comp-left">
        <div class="shoe-comp-header">
          <div class="shoe-comp-label">THEM</div>
          <div class="shoe-comp-type">TRADITIONAL<br>SHOES</div>
        </div>

        <div class="shoe-comp-features">
          {% for block in section.blocks %}
            {% if block.settings.side == 'left' %}
              <div class="shoe-comp-row">
                {% if block.settings.detail != blank %}
                  <span class="shoe-comp-text shoe-comp-negative">{{ block.settings.main }}</span>
                  <span class="shoe-comp-arrow">←</span>
                  <span class="shoe-comp-text shoe-comp-negative">{{ block.settings.detail }}</span>
                {% else %}
                  <span class="shoe-comp-text shoe-comp-negative">{{ block.settings.main }}</span>
                {% endif %}
              </div>
            {% endif %}
          {% endfor %}
        </div>
      </div>

      <div class="shoe-comp-image-container">
        {% if section.settings.comparison_image != blank %}
          <img
            src="{{ section.settings.comparison_image | image_url: width: 800 }}"
            alt="Shoe comparison"
            class="shoe-comp-image">
        {% else %}
          <img
            src="https://i.ibb.co/ZRBh4JjG/vs2.png"
            alt="Shoe comparison"
            class="shoe-comp-image">
        {% endif %}
      </div>

      <div class="shoe-comp-section shoe-comp-right">
        <div class="shoe-comp-header">
          <div class="shoe-comp-label">US</div>
          <div class="shoe-comp-type">ABSTRACT<br>CHIMP</div>
        </div>

        <div class="shoe-comp-features">
          {% for block in section.blocks %}
            {% if block.settings.side == 'right' %}
              <div class="shoe-comp-row">
                {% if block.settings.detail != blank %}
                  <span class="shoe-comp-text shoe-comp-positive">{{ block.settings.detail }}</span>
                  <span class="shoe-comp-arrow">→</span>
                  <span class="shoe-comp-text shoe-comp-positive">{{ block.settings.main }}</span>
                {% else %}
                  <span class="shoe-comp-text shoe-comp-positive">{{ block.settings.main }}</span>
                {% endif %}
              </div>
            {% endif %}
          {% endfor %}
        </div>
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Shoe Comparison",
  "settings": [
    {
      "type": "image_picker",
      "id": "comparison_image",
      "label": "Comparison Image"
    }
  ],
  "blocks": [
    {
      "type": "feature_row",
      "name": "Feature Row",
      "settings": [
        {
          "type": "select",
          "id": "side",
          "label": "Side",
          "options": [
            { "value": "left", "label": "Left (Traditional Shoes)" },
            { "value": "right", "label": "Right (Abstract Chimp)" }
          ],
          "default": "left"
        },
        {
          "type": "text",
          "id": "main",
          "label": "Main Text",
          "default": "Example feature"
        },
        {
          "type": "text",
          "id": "detail",
          "label": "Supporting Text (optional)",
          "default": "-"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Shoe Comparison",
      "blocks": [
        {
          "type": "feature_row",
          "settings": {
            "side": "left",
            "main": "misaligned posture",
            "detail": "elevated heel"
          }
        },
        {
          "type": "feature_row",
          "settings": {
            "side": "left",
            "main": "weakened feet",
            "detail": "arch support"
          }
        },
        {
          "type": "feature_row",
          "settings": {
            "side": "left",
            "main": "foot deformity",
            "detail": "narrow toe box"
          }
        },
        {
          "type": "feature_row",
          "settings": {
            "side": "left",
            "main": "no ground feedback",
            "detail": "rigid sole"
          }
        },
        {
          "type": "feature_row",
          "settings": {
            "side": "left",
            "main": "heavy & restrictive"
          }
        },
        {
          "type": "feature_row",
          "settings": {
            "side": "right",
            "main": "natural alignment",
            "detail": "zero drop"
          }
        },
        {
          "type": "feature_row",
          "settings": {
            "side": "right",
            "main": "stronger muscles",
            "detail": "no arch support"
          }
        },
        {
          "type": "feature_row",
          "settings": {
            "side": "right",
            "main": "happy, functional toes",
            "detail": "wide toe box"
          }
        },
        {
          "type": "feature_row",
          "settings": {
            "side": "right",
            "main": "proprioception",
            "detail": "flexible minimal sole"
          }
        },
        {
          "type": "feature_row",
          "settings": {
            "side": "right",
            "main": "lightweight freedom"
          }
        }
      ]
    }
  ]
}
{% endschema %}
