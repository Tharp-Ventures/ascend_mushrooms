{% schema %}
  {
    "name": "Shoe Comparison",
    "tag": "section",
    "class": "section shoe-comparison-section",
    "settings": [
      {
        "type": "color",
        "id": "background_color",
        "label": "Background Color",
        "default": "#ffffff"
      },
      {
        "type": "text",
        "id": "heading_text",
        "label": "Heading First Part",
        "default": "the difference is"
      },
      {
        "type": "text",
        "id": "heading_highlight",
        "label": "Heading Highlighted Part",
        "default": "night and day"
      },
      {
        "type": "text",
        "id": "heading_suffix",
        "label": "Heading Last Part",
        "default": "with abstract chimp shoes"
      },
      {
        "type": "color",
        "id": "highlight_color",
        "label": "Highlight Text Color",
        "default": "#5E8E5A"
      },
      {
        "type": "header",
        "content": "Labels and Images"
      },
      {
        "type": "text",
        "id": "left_label",
        "label": "Left Label",
        "default": "THEM"
      },
      {
        "type": "text",
        "id": "left_title",
        "label": "Left Title",
        "default": "TRADITIONAL SHOES"
      },
      {
        "type": "text",
        "id": "right_label",
        "label": "Right Label",
        "default": "US"
      },
      {
        "type": "text",
        "id": "right_title",
        "label": "Right Title",
        "default": "ABSTRACT CHIMP"
      },
      {
        "type": "image_picker",
        "id": "comparison_image",
        "label": "Comparison Image (with both soles and VS)"
      },
      {
        "type": "header",
        "content": "Comparison Points - Left"
      },
      {
        "type": "text",
        "id": "compare1_left",
        "label": "Traditional Point 1",
        "default": "elevated heel"
      },
      {
        "type": "text",
        "id": "compare1_left_result",
        "label": "Traditional Result 1",
        "default": "misaligned posture"
      },
      {
        "type": "text",
        "id": "compare2_left",
        "label": "Traditional Point 2",
        "default": "arch support"
      },
      {
        "type": "text",
        "id": "compare2_left_result",
        "label": "Traditional Result 2",
        "default": "weakened feet"
      },
      {
        "type": "text",
        "id": "compare3_left",
        "label": "Traditional Point 3",
        "default": "narrow toe box"
      },
      {
        "type": "text",
        "id": "compare3_left_result",
        "label": "Traditional Result 3",
        "default": "foot deformity"
      },
      {
        "type": "text",
        "id": "compare4_left",
        "label": "Traditional Point 4",
        "default": "rigid sole"
      },
      {
        "type": "text",
        "id": "compare4_left_result",
        "label": "Traditional Result 4",
        "default": "no ground feedback"
      },
      {
        "type": "text",
        "id": "compare5_left",
        "label": "Traditional Point 5",
        "default": "heavy & restrictive"
      },
      {
        "type": "text",
        "id": "compare5_left_result",
        "label": "Traditional Result 5",
        "default": "none"
      },
      {
        "type": "header",
        "content": "Comparison Points - Right"
      },
      {
        "type": "text",
        "id": "compare1_right",
        "label": "Abstract Chimp Point 1",
        "default": "zero drop"
      },
      {
        "type": "text",
        "id": "compare1_right_result",
        "label": "Abstract Chimp Result 1",
        "default": "natural alignment"
      },
      {
        "type": "text",
        "id": "compare2_right",
        "label": "Abstract Chimp Point 2",
        "default": "no arch support"
      },
      {
        "type": "text",
        "id": "compare2_right_result",
        "label": "Abstract Chimp Result 2",
        "default": "stronger muscles"
      },
      {
        "type": "text",
        "id": "compare3_right",
        "label": "Abstract Chimp Point 3",
        "default": "wide toe box"
      },
      {
        "type": "text",
        "id": "compare3_right_result",
        "label": "Abstract Chimp Result 3",
        "default": "happy, functional toes"
      },
      {
        "type": "text",
        "id": "compare4_right",
        "label": "Abstract Chimp Point 4",
        "default": "flexible minimal sole"
      },
      {
        "type": "text",
        "id": "compare4_right_result",
        "label": "Abstract Chimp Result 4",
        "default": "proprioception"
      },
      {
        "type": "text",
        "id": "compare5_right",
        "label": "Abstract Chimp Point 5",
        "default": "lightweight freedom"
      },
      {
        "type": "text",
        "id": "compare5_right_result",
        "label": "Abstract Chimp Result 5",
        "default": "none"
      }
    ],
    "presets": [
      {
        "name": "Shoe Comparison",
        "category": "Custom"
      }
    ]
  }
  {% endschema %}
  
  <style>
  .shoe-comparison-section {
    padding: 80px 0;
    background-color: {{ section.settings.background_color }};
  }
  
  .comparison-container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 20px;
  }
  
  .comparison-heading {
    text-align: center;
    margin-bottom: 80px;
  }
  
  .heading-text {
    font-size: 38px;
    line-height: 1.2;
    font-weight: 700;
    color: #333;
    margin: 0;
  }
  
  .heading-highlight {
    color: {{ section.settings.highlight_color }};
  }
  
  .comparison-layout {
    position: relative;
    max-width: 850px;
    margin: 0 auto;
  }
  
  .comparison-image-container {
    text-align: center;
    margin-bottom: 0;
    position: relative;
  }
  
  .comparison-main-image {
    max-width: 100%;
    height: auto;
    display: block;
    margin: 0 auto;
  }
  
  .comparison-labels {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    display: flex;
    justify-content: space-between;
    z-index: 2;
    padding: 0 20px;
  }
  
  .label-column {
    display: flex;
    flex-direction: column;
    align-items: center;
  }
  
  .left-column {
    padding-right: 100px;
  }
  
  .right-column {
    padding-left: 100px;
  }
  
  .column-label {
    font-size: 16px;
    font-weight: 500;
    color: {{ section.settings.highlight_color }};
    margin-bottom: 5px;
    text-transform: uppercase;
  }
  
  .column-title {
    font-size: 20px;
    font-weight: 700;
    color: #333;
    text-transform: uppercase;
    text-align: center;
  }
  
  .comparison-points {
    position: relative;
    margin-top: 30px;
  }
  
  .points-left,
  .points-right {
    position: absolute;
    top: 0;
    width: 40%;
  }
  
  .points-left {
    left: 0;
  }
  
  .points-right {
    right: 0;
  }
  
  .comparison-row {
    display: flex;
    margin-bottom: 15px;
    align-items: center;
  }
  
  .points-left .comparison-row {
    justify-content: flex-end;
  }
  
  .point-result {
    font-size: 15px;
    color: #333;
    line-height: 1.3;
  }
  
  .points-left .point-result {
    text-align: right;
    margin-right: 10px;
    width: 130px;
  }
  
  .points-right .point-result {
    text-align: left;
    margin-left: 10px;
    width: 130px;
  }
  
  .point-line {
    width: 80px;
    height: 1px;
    background-color: #999;
    position: relative;
  }
  
  .left-arrow {
    position: absolute;
    left: 0;
    top: -3px;
    width: 7px;
    height: 7px;
    border-top: 1px solid #999;
    border-right: 1px solid #999;
    transform: rotate(-135deg);
  }
  
  .right-arrow {
    position: absolute;
    right: 0;
    top: -3px;
    width: 7px;
    height: 7px;
    border-top: 1px solid #999;
    border-right: 1px solid #999;
    transform: rotate(45deg);
  }
  
  .point-text {
    font-size: 15px;
    color: #333;
    line-height: 1.3;
  }
  
  .points-left .point-text {
    text-align: left;
    margin-left: 10px;
    width: 130px;
  }
  
  .points-right .point-text {
    text-align: right;
    margin-right: 10px;
    width: 130px;
  }
  
  @media screen and (max-width: 989px) {
    .heading-text {
      font-size: 32px;
    }
    
    .left-column {
      padding-right: 50px;
    }
    
    .right-column {
      padding-left: 50px;
    }
    
    .point-result, 
    .point-text {
      font-size: 14px;
      width: 120px;
    }
    
    .point-line {
      width: 60px;
    }
  }
  
  @media screen and (max-width: 749px) {
    .shoe-comparison-section {
      padding: 40px 0;
    }
    
    .comparison-heading {
      margin-bottom: 40px;
    }
    
    .heading-text {
      font-size: 26px;
    }
    
    .comparison-layout {
      display: flex;
      flex-direction: column;
    }
    
    .comparison-labels {
      position: relative;
      margin-bottom: 20px;
      padding: 0;
    }
    
    .left-column,
    .right-column {
      padding: 0;
    }
    
    .comparison-image-container {
      order: 2;
      margin-bottom: 30px;
    }
    
    .comparison-points {
      order: 3;
      margin-top: 0;
    }
    
    .points-left,
    .points-right {
      position: relative;
      width: 100%;
      margin-bottom: 30px;
    }
    
    .points-left .comparison-row,
    .points-right .comparison-row {
      justify-content: center;
    }
    
    .points-left .point-result,
    .points-left .point-text,
    .points-right .point-result,
    .points-right .point-text {
      width: 120px;
      font-size: 13px;
    }
    
    .point-line {
      width: 40px;
    }
  }
  </style>
  
  <div class="shoe-comparison-section">
    <div class="comparison-container">
      <div class="comparison-heading">
        <h2 class="heading-text">
          {{ section.settings.heading_text }} <span class="heading-highlight">{{ section.settings.heading_highlight }}</span><br>
          {{ section.settings.heading_suffix }}
        </h2>
      </div>
      
      <div class="comparison-layout">
        <div class="comparison-labels">
          <div class="label-column left-column">
            <div class="column-label">{{ section.settings.left_label }}</div>
            <div class="column-title">{{ section.settings.left_title }}</div>
          </div>
          
          <div class="label-column right-column">
            <div class="column-label">{{ section.settings.right_label }}</div>
            <div class="column-title">{{ section.settings.right_title }}</div>
          </div>
        </div>
        
        <div class="comparison-image-container">
          {% if section.settings.comparison_image %}
            {{ section.settings.comparison_image | image_url: width: 1000 | image_tag: 
              class: 'comparison-main-image',
              loading: 'lazy',
              alt: 'Shoe comparison'
            }}
          {% endif %}
        </div>
        
        <div class="comparison-points">
          <div class="points-left">
            <div class="comparison-row">
              <div class="point-result">{{ section.settings.compare1_left_result }}</div>
              <div class="point-line"><div class="left-arrow"></div></div>
              <div class="point-text">{{ section.settings.compare1_left }}</div>
            </div>
            
            <div class="comparison-row">
              <div class="point-result">{{ section.settings.compare2_left_result }}</div>
              <div class="point-line"><div class="left-arrow"></div></div>
              <div class="point-text">{{ section.settings.compare2_left }}</div>
            </div>
            
            <div class="comparison-row">
              <div class="point-result">{{ section.settings.compare3_left_result }}</div>
              <div class="point-line"><div class="left-arrow"></div></div>
              <div class="point-text">{{ section.settings.compare3_left }}</div>
            </div>
            
            <div class="comparison-row">
              <div class="point-result">{{ section.settings.compare4_left_result }}</div>
              <div class="point-line"><div class="left-arrow"></div></div>
              <div class="point-text">{{ section.settings.compare4_left }}</div>
            </div>
            
            <div class="comparison-row">
              <div class="point-result">{% if section.settings.compare5_left_result != 'none' %}{{ section.settings.compare5_left_result }}{% endif %}</div>
              <div class="point-line"><div class="left-arrow"></div></div>
              <div class="point-text">{{ section.settings.compare5_left }}</div>
            </div>
          </div>
          
          <div class="points-right">
            <div class="comparison-row">
              <div class="point-text">{{ section.settings.compare1_right }}</div>
              <div class="point-line"><div class="right-arrow"></div></div>
              <div class="point-result">{{ section.settings.compare1_right_result }}</div>
            </div>
            
            <div class="comparison-row">
              <div class="point-text">{{ section.settings.compare2_right }}</div>
              <div class="point-line"><div class="right-arrow"></div></div>
              <div class="point-result">{{ section.settings.compare2_right_result }}</div>
            </div>
            
            <div class="comparison-row">
              <div class="point-text">{{ section.settings.compare3_right }}</div>
              <div class="point-line"><div class="right-arrow"></div></div>
              <div class="point-result">{{ section.settings.compare3_right_result }}</div>
            </div>
            
            <div class="comparison-row">
              <div class="point-text">{{ section.settings.compare4_right }}</div>
              <div class="point-line"><div class="right-arrow"></div></div>
              <div class="point-result">{{ section.settings.compare4_right_result }}</div>
            </div>
            
            <div class="comparison-row">
              <div class="point-text">{{ section.settings.compare5_right }}</div>
              <div class="point-line"><div class="right-arrow"></div></div>
              <div class="point-result">{% if section.settings.compare5_right_result != 'none' %}{{ section.settings.compare5_right_result }}{% endif %}</div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>