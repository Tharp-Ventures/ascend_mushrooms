{% schema %}
  {
    "name": "Shoe Comparison",
    "tag": "section",
    "class": "section shoe-comparison-section",
    "settings": [
      {
        "type": "color",
        "id": "background_color",
        "label": "Background Color",
        "default": "#f8f8f8"
      },
      {
        "type": "text",
        "id": "heading_text",
        "label": "Heading First Part",
        "default": "the difference is"
      },
      {
        "type": "text",
        "id": "heading_highlight",
        "label": "Heading Highlighted Part",
        "default": "night and day"
      },
      {
        "type": "text",
        "id": "heading_suffix",
        "label": "Heading Last Part",
        "default": "with abstract chimp shoes"
      },
      {
        "type": "color",
        "id": "highlight_color",
        "label": "Highlight Text Color",
        "default": "#5E8E5A"
      },
      {
        "type": "header",
        "content": "Labels and Images"
      },
      {
        "type": "text",
        "id": "left_label",
        "label": "Left Label",
        "default": "THEM"
      },
      {
        "type": "text",
        "id": "left_title",
        "label": "Left Title",
        "default": "TRADITIONAL SHOES"
      },
      {
        "type": "text",
        "id": "right_label",
        "label": "Right Label",
        "default": "US"
      },
      {
        "type": "text",
        "id": "right_title",
        "label": "Right Title",
        "default": "ABSTRACT CHIMP"
      },
      {
        "type": "image_picker",
        "id": "comparison_image",
        "label": "Comparison Image (with both soles and VS)"
      },
      {
        "type": "header",
        "content": "Comparison Points - Left"
      },
      {
        "type": "text",
        "id": "compare1_left",
        "label": "Traditional Point 1",
        "default": "elevated heel"
      },
      {
        "type": "text",
        "id": "compare1_left_result",
        "label": "Traditional Result 1",
        "default": "misaligned posture"
      },
      {
        "type": "text",
        "id": "compare2_left",
        "label": "Traditional Point 2",
        "default": "arch support"
      },
      {
        "type": "text",
        "id": "compare2_left_result",
        "label": "Traditional Result 2",
        "default": "weakened feet"
      },
      {
        "type": "text",
        "id": "compare3_left",
        "label": "Traditional Point 3",
        "default": "narrow toe box"
      },
      {
        "type": "text",
        "id": "compare3_left_result",
        "label": "Traditional Result 3",
        "default": "foot deformity"
      },
      {
        "type": "text",
        "id": "compare4_left",
        "label": "Traditional Point 4",
        "default": "rigid sole"
      },
      {
        "type": "text",
        "id": "compare4_left_result",
        "label": "Traditional Result 4",
        "default": "no ground feedback"
      },
      {
        "type": "text",
        "id": "compare5_left",
        "label": "Traditional Point 5",
        "default": "heavy & restrictive"
      },
      {
        "type": "text",
        "id": "compare5_left_result",
        "label": "Traditional Result 5",
        "default": "none"
      },
      {
        "type": "header",
        "content": "Comparison Points - Right"
      },
      {
        "type": "text",
        "id": "compare1_right",
        "label": "Abstract Chimp Point 1",
        "default": "zero drop"
      },
      {
        "type": "text",
        "id": "compare1_right_result",
        "label": "Abstract Chimp Result 1",
        "default": "natural alignment"
      },
      {
        "type": "text",
        "id": "compare2_right",
        "label": "Abstract Chimp Point 2",
        "default": "no arch support"
      },
      {
        "type": "text",
        "id": "compare2_right_result",
        "label": "Abstract Chimp Result 2",
        "default": "stronger muscles"
      },
      {
        "type": "text",
        "id": "compare3_right",
        "label": "Abstract Chimp Point 3",
        "default": "wide toe box"
      },
      {
        "type": "text",
        "id": "compare3_right_result",
        "label": "Abstract Chimp Result 3",
        "default": "happy, functional toes"
      },
      {
        "type": "text",
        "id": "compare4_right",
        "label": "Abstract Chimp Point 4",
        "default": "flexible minimal sole"
      },
      {
        "type": "text",
        "id": "compare4_right_result",
        "label": "Abstract Chimp Result 4",
        "default": "proprioception"
      },
      {
        "type": "text",
        "id": "compare5_right",
        "label": "Abstract Chimp Point 5",
        "default": "lightweight freedom"
      },
      {
        "type": "text",
        "id": "compare5_right_result",
        "label": "Abstract Chimp Result 5",
        "default": "none"
      }
    ],
    "presets": [
      {
        "name": "Shoe Comparison",
        "category": "Custom"
      }
    ]
  }
  {% endschema %}
  
  <style>
  .shoe-comparison-section {
    padding: 80px 0;
    background-color: {{ section.settings.background_color }};
  }
  
  .comparison-container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 20px;
  }
  
  .comparison-heading {
    text-align: center;
    margin-bottom: 80px;
  }
  
  .heading-text {
    font-size: 38px;
    line-height: 1.2;
    font-weight: 700;
    color: #333;
    margin: 0;
  }
  
  .heading-highlight {
    color: {{ section.settings.highlight_color }};
  }
  
  .comparison-main {
    display: flex;
    flex-direction: column;
    align-items: center;
    position: relative;
  }
  
  .comparison-image-row {
    display: flex;
    justify-content: center;
    align-items: flex-start;
    width: 100%;
    margin: 40px 0 30px;
    position: relative;
  }
  
  .comparison-image {
    max-width: 600px;
    width: 50%;
    margin: 0 auto;
  }
  
  .left-labels {
    width: 25%;
    text-align: right;
    padding-right: 20px;
    margin-top: 20px;
  }
  
  .right-labels {
    width: 25%;
    text-align: left;
    padding-left: 20px;
    margin-top: 20px;
  }
  
  .label-text {
    color: {{ section.settings.highlight_color }};
    text-transform: uppercase;
    font-size: 16px;
    font-weight: 500;
    margin-bottom: 5px;
  }
  
  .title-text {
    font-size: 21px;
    font-weight: 700;
    color: #333;
    text-transform: uppercase;
  }
  
  .left-features,
  .right-features {
    width: 100%;
    max-width: 1000px;
    margin-top: 20px;
    position: relative;
  }
  
  .feature-row {
    display: flex;
    align-items: center;
    margin-bottom: 20px;
    position: relative;
  }
  
  .left-feature-row {
    padding-left: 5%;
    padding-right: 55%;
    justify-content: flex-start;
  }
  
  .right-feature-row {
    padding-right: 5%;
    padding-left: 55%;
    justify-content: flex-end;
  }
  
  .feature-result {
    font-size: 16px;
    line-height: 1.2;
    color: #333;
  }
  
  .left-feature-result {
    text-align: right;
    margin-right: 10px;
    width: 170px;
  }
  
  .right-feature-result {
    text-align: left;
    margin-left: 10px;
    width: 170px;
  }
  
  .feature-line {
    height: 1px;
    background-color: #999;
    position: relative;
    flex-grow: 1;
    max-width: 100px;
  }
  
  .left-arrow {
    display: none;
  }
  
  .right-arrow {
    display: none;
  }
  
  .feature-name {
    font-size: 16px;
    line-height: 1.2;
    color: #333;
  }
  
  .left-feature-name {
    text-align: left;
    margin-left: 10px;
    width: 150px;
  }
  
  .right-feature-name {
    text-align: right;
    margin-right: 10px;
    width: 150px;
  }
  
  @media screen and (max-width: 989px) {
    .heading-text {
      font-size: 32px;
    }
    
    .left-feature-row {
      padding-right: 50%;
    }
    
    .right-feature-row {
      padding-left: 50%;
    }
    
    .feature-result, 
    .feature-name {
      font-size: 15px;
    }
    
    .left-feature-result,
    .right-feature-result {
      width: 150px;
    }
    
    .left-feature-name,
    .right-feature-name {
      width: 130px;
    }
  }
  
  @media screen and (max-width: 749px) {
    .shoe-comparison-section {
      padding: 40px 0;
    }
    
    .comparison-heading {
      margin-bottom: 40px;
    }
    
    .heading-text {
      font-size: 26px;
    }
    
    .comparison-image-row {
      flex-direction: column;
      align-items: center;
    }
    
    .left-labels,
    .right-labels {
      width: 100%;
      text-align: center;
      padding: 0;
      margin-bottom: 20px;
    }
    
    .comparison-image {
      width: 80%;
      order: 3;
    }
    
    .left-feature-row,
    .right-feature-row {
      padding: 0;
      justify-content: space-between;
      max-width: 350px;
      margin: 0 auto;
    }
    
    .left-feature-result,
    .right-feature-result,
    .left-feature-name,
    .right-feature-name {
      width: 130px;
      font-size: 14px;
    }
    
    .feature-line {
      max-width: 50px;
    }
  }
  </style>
  
  <div class="shoe-comparison-section">
    <div class="comparison-container">
      <div class="comparison-heading">
        <h2 class="heading-text">
          {{ section.settings.heading_text }} <span class="heading-highlight">{{ section.settings.heading_highlight }}</span><br>
          {{ section.settings.heading_suffix }}
        </h2>
      </div>
      
      <div class="comparison-main">
        <div class="comparison-image-row">
          <div class="left-labels">
            <div class="label-text">{{ section.settings.left_label }}</div>
            <div class="title-text">{{ section.settings.left_title }}</div>
          </div>
          
          <div class="comparison-image">
            {% if section.settings.comparison_image %}
              {{ section.settings.comparison_image | image_url: width: 800 | image_tag: 
                loading: 'lazy',
                alt: 'Shoe comparison'
              }}
            {% endif %}
          </div>
          
          <div class="right-labels">
            <div class="label-text">{{ section.settings.right_label }}</div>
            <div class="title-text">{{ section.settings.right_title }}</div>
          </div>
        </div>
        
        <div class="left-features">
          <div class="feature-row left-feature-row">
            <div class="feature-result left-feature-result">{{ section.settings.compare1_left_result }}</div>
            <div class="feature-line left-feature-line"><div class="left-arrow"></div></div>
            <div class="feature-name left-feature-name">{{ section.settings.compare1_left }}</div>
          </div>
          
          <div class="feature-row left-feature-row">
            <div class="feature-result left-feature-result">{{ section.settings.compare2_left_result }}</div>
            <div class="feature-line left-feature-line"><div class="left-arrow"></div></div>
            <div class="feature-name left-feature-name">{{ section.settings.compare2_left }}</div>
          </div>
          
          <div class="feature-row left-feature-row">
            <div class="feature-result left-feature-result">{{ section.settings.compare3_left_result }}</div>
            <div class="feature-line left-feature-line"><div class="left-arrow"></div></div>
            <div class="feature-name left-feature-name">{{ section.settings.compare3_left }}</div>
          </div>
          
          <div class="feature-row left-feature-row">
            <div class="feature-result left-feature-result">{{ section.settings.compare4_left_result }}</div>
            <div class="feature-line left-feature-line"><div class="left-arrow"></div></div>
            <div class="feature-name left-feature-name">{{ section.settings.compare4_left }}</div>
          </div>
          
          <div class="feature-row left-feature-row">
            <div class="feature-result left-feature-result">{% if section.settings.compare5_left_result != 'none' %}{{ section.settings.compare5_left_result }}{% endif %}</div>
            <div class="feature-line left-feature-line"><div class="left-arrow"></div></div>
            <div class="feature-name left-feature-name">{{ section.settings.compare5_left }}</div>
          </div>
        </div>
        
        <div class="right-features">
          <div class="feature-row right-feature-row">
            <div class="feature-name right-feature-name">{{ section.settings.compare1_right }}</div>
            <div class="feature-line right-feature-line"><div class="right-arrow"></div></div>
            <div class="feature-result right-feature-result">{{ section.settings.compare1_right_result }}</div>
          </div>
          
          <div class="feature-row right-feature-row">
            <div class="feature-name right-feature-name">{{ section.settings.compare2_right }}</div>
            <div class="feature-line right-feature-line"><div class="right-arrow"></div></div>
            <div class="feature-result right-feature-result">{{ section.settings.compare2_right_result }}</div>
          </div>
          
          <div class="feature-row right-feature-row">
            <div class="feature-name right-feature-name">{{ section.settings.compare3_right }}</div>
            <div class="feature-line right-feature-line"><div class="right-arrow"></div></div>
            <div class="feature-result right-feature-result">{{ section.settings.compare3_right_result }}</div>
          </div>
          
          <div class="feature-row right-feature-row">
            <div class="feature-name right-feature-name">{{ section.settings.compare4_right }}</div>
            <div class="feature-line right-feature-line"><div class="right-arrow"></div></div>
            <div class="feature-result right-feature-result">{{ section.settings.compare4_right_result }}</div>
          </div>
          
          <div class="feature-row right-feature-row">
            <div class="feature-name right-feature-name">{{ section.settings.compare5_right }}</div>
            <div class="feature-line right-feature-line"><div class="right-arrow"></div></div>
            <div class="feature-result right-feature-result">{% if section.settings.compare5_right_result != 'none' %}{{ section.settings.compare5_right_result }}{% endif %}</div>
          </div>
        </div>
      </div>
    </div>
  </div>