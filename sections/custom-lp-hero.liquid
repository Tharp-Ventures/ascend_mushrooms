{% schema %}
  {
    "name": "Custom LP Hero",
    "tag": "section",
    "class": "section custom-lp-hero-section",
    "settings": [
      {
        "type": "image_picker",
        "id": "background_image",
        "label": "Background Image (with shoes)"
      },
      {
        "type": "range",
        "id": "content_position",
        "label": "Content vertical position",
        "min": 10,
        "max": 90,
        "step": 5,
        "unit": "%",
        "default": 30
      },
      {
        "type": "text",
        "id": "rating_text",
        "label": "Rating Text",
        "default": "100+ of happy feet"
      },
      {
        "type": "text",
        "id": "heading",
        "label": "Heading",
        "default": "reboot your life from the shoe up"
      },
      {
        "type": "textarea",
        "id": "description",
        "label": "Description",
        "default": "built on the principles that drove human evolution, fission.01 helps you move and feel like you were designed to."
      },
      {
        "type": "text",
        "id": "button_text",
        "label": "Button Text",
        "default": "SHOP NOW"
      },
      {
        "type": "url",
        "id": "button_link",
        "label": "Button Link"
      },
      {
        "type": "image_picker",
        "id": "feature1_icon",
        "label": "Feature 1 Icon"
      },
      {
        "type": "text",
        "id": "feature1_title",
        "label": "Feature 1 Title",
        "default": "Zero Drop"
      },
      {
        "type": "text",
        "id": "feature1_text",
        "label": "Feature 1 Text",
        "default": "full-body strength & alignment"
      },
      {
        "type": "image_picker",
        "id": "feature2_icon",
        "label": "Feature 2 Icon"
      },
      {
        "type": "text",
        "id": "feature2_title",
        "label": "Feature 2 Title",
        "default": "Wide toe box"
      },
      {
        "type": "text",
        "id": "feature2_text",
        "label": "Feature 2 Text",
        "default": "foot freedom, finally"
      },
      {
        "type": "image_picker",
        "id": "feature3_icon",
        "label": "Feature 3 Icon"
      },
      {
        "type": "text",
        "id": "feature3_title",
        "label": "Feature 3 Title",
        "default": "Maximum style"
      },
      {
        "type": "text",
        "id": "feature3_text",
        "label": "Feature 3 Text",
        "default": "minimal branding"
      }
    ],
    "presets": [
      {
        "name": "Custom LP Hero",
        "category": "Custom"
      }
    ]
  }
  {% endschema %}
  
  <style>
  .custom-lp-hero-section {
    position: relative;
    width: 100%;
    height: 100vh;
    padding: 0;
    margin: 0;
    overflow: hidden;
  }
  
  .custom-lp-hero-bg {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: 1;
  }
  
  .custom-lp-hero-container {
    position: relative;
    z-index: 2;
    width: 100%;
    max-width: 1400px;
    height: 100%;
    margin: 0 auto;
    padding: 0 20px;
    display: flex;
    align-items: flex-start;
  }
  
  .custom-lp-hero-content {
    width: 60%;
    max-width: 600px;
    padding: 0;
    margin-top: 80px;
  }
  
  .rating-wrapper {
    display: flex;
    align-items: center;
    margin-bottom: 20px;
  }
  
  .rating-stars {
    display: flex;
    color: #5E8E5A;
    margin-right: 10px;
  }
  
  .star {
    color: #5E8E5A;
  }
  
  .rating-text {
    color: #5E8E5A;
    font-size: 16px;
  }
  
  .hero-heading {
    font-size: 72px;
    line-height: 1.1;
    font-weight: 900;
    color: #333;
    margin: 0 0 20px 0;
  }
  
  .hero-description {
    font-size: 18px;
    line-height: 1.5;
    color: #333;
    margin-bottom: 30px;
  }
  
  .features {
    display: flex;
    margin-bottom: 40px;
  }
  
  .feature {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    border-right: 1px solid #000;
    padding: 0 20px;
    width: 33.333%;
  }
  
  .feature:first-child {
    padding-left: 0;
  }
  
  .feature:last-child {
    border-right: none;
    padding-right: 0;
  }
  
  .feature-icon {
    width: 40px;
    height: 40px;
    margin-bottom: 10px;
  }
  
  .feature-title {
    font-weight: 700;
    font-size: 16px;
    margin-bottom: 5px;
    color: #333;
  }
  
  .feature-text {
    font-size: 14px;
    line-height: 1.3;
    color: #333;
  }
  
  .shop-now-btn {
    display: inline-block;
    background-color: #5E8E5A;
    color: white;
    font-weight: 600;
    font-size: 16px;
    padding: 15px 40px;
    text-decoration: none;
    border-radius: 3px;
    text-align: center;
    text-transform: uppercase;
    letter-spacing: 1px;
    border: none;
    cursor: pointer;
    max-width: 260px;
    width: 100%;
  }
  
  .shipping-info {
    display: flex;
    margin-top: 20px;
  }
  
  .shipping-item {
    display: flex;
    align-items: center;
    margin-right: 20px;
    font-size: 14px;
    color: rgba(53, 106, 82, 1);
  }
  
  .shipping-icon {
    margin-right: 8px;
  }
  
  @media screen and (max-width: 989px) {
    .custom-lp-hero-content {
      width: 80%;
    }
    
    .hero-heading {
      font-size: 48px;
    }
  }
  
  @media screen and (max-width: 749px) {
    .custom-lp-hero-section {
      height: auto;
      min-height: 100vh;
    }
    
    .custom-lp-hero-container {
      padding: 60px 20px;
      align-items: center;
    }
    
    .custom-lp-hero-content {
      width: 100%;
    }
    
    .hero-heading {
      font-size: 36px;
    }
    
    .features {
      flex-direction: column;
    }
    
    .feature {
      width: 100%;
      border-right: none;
      border-bottom: 1px solid rgba(0,0,0,0.1);
      padding: 15px 0;
      flex-direction: row;
      text-align: left;
      align-items: flex-start;
    }
    
    .feature:last-child {
      border-bottom: none;
    }
    
    .feature-icon {
      margin-right: 15px;
      margin-bottom: 0;
    }
    
    .shipping-info {
      flex-direction: column;
    }
    
    .shipping-item {
      margin-bottom: 10px;
    }
  }
  </style>
  
  <div class="custom-lp-hero-section">
    {% if section.settings.background_image %}
      {{ section.settings.background_image | image_url: width: 2000 | image_tag: 
        class: 'custom-lp-hero-bg',
        loading: 'eager',
        alt: section.settings.heading
      }}
    {% else %}
      <div class="custom-lp-hero-bg" style="background-color: #9ecbec;"></div>
    {% endif %}
    
    <div class="custom-lp-hero-container" style="align-items: {{ section.settings.content_position | default: 30 }}%;">
      <div class="custom-lp-hero-content">
        <div class="rating-wrapper">
          <div class="rating-stars">
            <span class="star">★</span>
            <span class="star">★</span>
            <span class="star">★</span>
            <span class="star">★</span>
            <span class="star">★</span>
          </div>
          <span class="rating-text">{{ section.settings.rating_text }}</span>
        </div>
        
        <h1 class="hero-heading">{{ section.settings.heading }}</h1>
        <p class="hero-description">{{ section.settings.description }}</p>
        
        <div class="features">
          <div class="feature">
            {% if section.settings.feature1_icon %}
              {{ section.settings.feature1_icon | image_url: width: 100 | image_tag: 
                class: 'feature-icon',
                alt: section.settings.feature1_title
              }}
            {% else %}
              <img src="{{ 'vitruvian-man.png' | asset_url }}" alt="Zero Drop" class="feature-icon">
            {% endif %}
            <div class="feature-title">{{ section.settings.feature1_title }}</div>
            <div class="feature-text">{{ section.settings.feature1_text }}</div>
          </div>
          
          <div class="feature">
            {% if section.settings.feature2_icon %}
              {{ section.settings.feature2_icon | image_url: width: 100 | image_tag: 
                class: 'feature-icon',
                alt: section.settings.feature2_title
              }}
            {% else %}
              <img src="{{ 'foot-icon.png' | asset_url }}" alt="Wide toe box" class="feature-icon">
            {% endif %}
            <div class="feature-title">{{ section.settings.feature2_title }}</div>
            <div class="feature-text">{{ section.settings.feature2_text }}</div>
          </div>
          
          <div class="feature">
            {% if section.settings.feature3_icon %}
              {{ section.settings.feature3_icon | image_url: width: 100 | image_tag: 
                class: 'feature-icon',
                alt: section.settings.feature3_title
              }}
            {% else %}
              <img src="{{ 'style-icon.png' | asset_url }}" alt="Maximum style" class="feature-icon">
            {% endif %}
            <div class="feature-title">{{ section.settings.feature3_title }}</div>
            <div class="feature-text">{{ section.settings.feature3_text }}</div>
          </div>
        </div>
        
        <a href="{{ section.settings.button_link | default: '#' }}" class="shop-now-btn">
          {{ section.settings.button_text }}
        </a>
        
        <div class="shipping-info">
          <div class="shipping-item">
            <span class="shipping-icon">
              <svg width="18" height="17" viewBox="0 0 18 17" fill="none" xmlns="http://www.w3.org/2000/svg">
                <g clip-path="url(#clip0_134_829)">
