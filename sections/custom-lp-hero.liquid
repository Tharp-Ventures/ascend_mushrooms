                </g>
                <defs>
                <clipPath id="clip0_134_829">
                <rect width="16.9727" height="16.9727" fill="white" transform="translate(0.972656)"/>
                </clipPath>
                </defs>
              </svg>
            </span>
            <span>Free Shipping</span>
          </div>
          
          <div class="shipping-item">
            <span class="shipping-icon">
              <svg width="12" height="15" viewBox="0 0 12 15" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M5.51367 1.08359L5.72355 0.592691C5.65722 0.564314 5.58582 0.549683 5.51367 0.549683C5.44152 0.549683 5.37013 0.564314 5.3038 0.592691L5.51367 1.08359ZM5.51367 13.8895L5.24902 14.3527C5.32962 14.3987 5.42084 14.4229 5.51367 14.4229C5.6065 14.4229 5.69772 14.3987 5.77833 14.3527L5.51367 13.8895ZM5.30309 0.593403L0.755551 2.54204L1.17388 3.52383L5.72284 1.57448L5.30309 0.593403ZM0 3.68675V8.56724H1.06716V3.68675H0ZM2.41961 12.7363L5.24902 14.3527L5.77833 13.4264L2.94893 11.8093L2.41961 12.7363ZM5.77833 14.3527L8.60773 12.7363L8.07842 11.8093L5.24902 13.4264L5.77833 14.3527ZM11.0273 8.56653V3.68746H9.96018V8.56795L11.0273 8.56653ZM10.2732 2.54275L5.72355 0.593403L5.3038 1.57377L9.85275 3.52383L10.2732 2.54275ZM11.0273 3.68746C11.0273 3.18945 10.7307 2.73911 10.2732 2.54275L9.85275 3.52383C9.8847 3.53761 9.91191 3.56045 9.931 3.58954C9.9501 3.61862 9.96024 3.65267 9.96018 3.68746H11.0273ZM8.60773 12.7363C9.3427 12.3163 9.9536 11.7095 10.3785 10.9773C10.8034 10.2452 11.0273 9.41375 11.0273 8.56724H9.96018C9.96004 9.22553 9.78592 9.87209 9.45547 10.4414C9.12501 11.0108 8.64995 11.4826 8.07842 11.8093L8.60773 12.7363ZM0 8.56724C7.59604e-05 9.41375 0.223913 10.2452 0.648828 10.9773C1.07374 11.7095 1.68464 12.3163 2.41961 12.7363L2.94893 11.8093C2.37729 11.4826 1.90216 11.0106 1.5717 10.4411C1.24124 9.87164 1.06718 9.22494 1.06716 8.56653L0 8.56724ZM0.754128 2.54204C0.530313 2.63807 0.339577 2.79763 0.205535 3.00097C0.0714927 3.20431 3.18481e-05 3.44321 0 3.68675H1.06716C1.06716 3.61561 1.10985 3.55087 1.1753 3.52241L0.754128 2.54204Z" fill="#356A52"/>
